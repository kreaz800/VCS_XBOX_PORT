#include <hal/debug.h>
#include <hal/video.h>
#include <windows.h>

#include "psprecomp/runtime.hpp"

namespace psprecomp {
void register_generated_functions(Runtime &runtime);
}

int main(void) {
    XVideoSetMode(640, 480, 32, REFRESH_DEFAULT);

    debugPrint("VCS Xbox runtime test starting...\n");

    psprecomp::Runtime runtime(32u * 1024u * 1024u);

    debugPrint("Runtime created successfully.\n");

    psprecomp::register_generated_functions(runtime);

    debugPrint("VCS functions registered: %u\n",
               (unsigned)runtime.function_count());

    while (true) {
        Sleep(1000);
    }

    return 0;
}
